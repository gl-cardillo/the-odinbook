{
  "name": "odinbook-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@odinbook/shared": "1.0.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^7.18.4",
    "yup": "^1.7.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p cypress/tsconfig.json",
    "lint": "eslint .",
    "e2e:api": "npm --prefix ../server run e2e:server",
    "e2e:client": "vite build --mode e2e && vite preview --mode e2e --port 4173 --strictPort",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "e2e": "start-server-and-test e2e:api http://localhost:5050 e2e:client http://localhost:4173 cy:run",
    "e2e:open": "start-server-and-test e2e:api http://localhost:5050 e2e:client http://localhost:4173 cy:open"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "sass": "^1.105.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
